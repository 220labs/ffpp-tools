#!/usr/bin/env python3
"""Blur people who did not agree to be in a film — scan, apply, check. The tool and its help are
scripts/blur/blur.py; this is the name bin/tool runs (bin/tool blur scan <clip>)."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "blur"))
import blur  # noqa: E402

if __name__ == "__main__":
    sys.exit(blur.main(sys.argv[1:]))
